# 后端环境变量示例
# 使用方式：复制为 server/.env 后按需修改（cp .env.example .env）
# 安全纪律：.env 已被 .gitignore 排除，任何情况下都不要提交真实密钥

# ── DeepSeek（AI 能力）────────────────────────────────
# 留空也能启动：AI 会降级为 [MOCK-AI] 占位回复，不影响其余功能
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 对话模型：推理模型，思考过程会映射到前端「思考块」
DEEPSEEK_MODEL=deepseek-v4-pro
# 意图分类模型：必须用轻量模型（语义解析 ≤2s SLO），用 pro 会超时降级
DEEPSEEK_CLASSIFY_MODEL=deepseek-chat

# ── PostgreSQL ────────────────────────────────────────
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=workbench
PG_PASSWORD=workbench
PG_DB=workbench

# ── 建表开关 ──────────────────────────────────────────
# 首次启动必须为 1（自动建表 + 灌入种子数据）；建表完成后改为 0，结构变更走 migration
TYPEORM_SYNC=1

# ── 服务端口 ──────────────────────────────────────────
PORT=3000
